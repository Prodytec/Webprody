PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Email de destino para las consultas del formulario de contacto
CONTACT_TO_EMAIL=consultas@prodytec.com

# SMTP opcional: si se deja vacío, los mensajes solo se guardan en backend/data/contacts.json
# Proveedor: Brevo (smtp-relay.brevo.com). SMTP_USER/SMTP_PASS son las credenciales SMTP de Brevo.
# SMTP_FROM debe ser una dirección de remitente verificada en la cuenta de Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Base de datos MySQL/MariaDB (blog). La tabla se crea sola al iniciar el servidor.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Captcha Cloudflare Turnstile (login del admin y formulario de contacto).
# Crear un widget gratis en https://dash.cloudflare.com/?to=/:account/turnstile y copiar las dos claves.
# En desarrollo, si se dejan vacías se usan las claves de prueba de Cloudflare; en producción son obligatorias.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin del blog (/admin.html). Opcionales: sin ellos se usa el usuario/contraseña por defecto.
ADMIN_USER=
ADMIN_PASS=
# Texto largo y aleatorio para firmar la sesión (recomendado en producción)
SESSION_SECRET=
